# Copia este archivo como .env.local para desarrollo y agrega las mismas variables en Vercel
# (Project → Settings → Environment Variables). Todas son opcionales: sin ellas el sitio
# compila igual y el formulario muestra un enlace mailto como alternativa.

# Resend (https://resend.com) para enviar los mensajes del formulario de contacto.
RESEND_API_KEY=
# Correo que recibe los mensajes. Por defecto: jefersonmorillo5858@gmail.com
CONTACT_TO_EMAIL=
# Remitente. Hasta verificar un dominio en Resend usa: Portafolio de Jeferson Morillo <onboarding@resend.dev>
CONTACT_FROM_EMAIL=

# Opcional: Upstash Redis para el límite de envíos (3 cada 10 minutos por IP).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
